{
  "name": "gram-10m-mainnet",
  "version": "1.0.0",
  "private": true,
  "description": "Reproducible verification workspace for GRAM 10M Mainnet",
  "scripts": {
    "clean": "node scripts/clean.mjs",
    "build:verified": "npm run clean && npx --no-install @ton/tolk-js --output-json build/gram-10m-mainnet.json verified-source/gram-10m-mainnet/contracts/JettonMinter.tolk",
    "verify": "node scripts/verify-remediation.mjs",
    "test": "npm run build:verified && node --test tests/*.test.mjs && npm run verify"
  },
  "devDependencies": {
    "@ton/tolk-js": "1.4.0"
  },
  "engines": {
    "node": ">=20"
  }
}
